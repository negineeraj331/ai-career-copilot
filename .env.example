# Career Copilot — environment template
#
# Copy to .env and fill in. Every variable here is validated by a Zod schema at
# boot (apps/api/src/config/env.ts); a missing or malformed value crashes the
# process immediately rather than failing confusingly under load.
#
# NEVER commit a real .env. Values below are development defaults only.

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Port 54000, not 4000: another local project already serves 4000 on this
# machine. Same 5xxxx block as the datastores, for one consistent story.
NODE_ENV=development
PORT=54000
API_URL=http://localhost:54000
WEB_URL=http://localhost:5173
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# High ports, not 5432/5433: both are already answered by other Postgres servers
# on this machine (one of them invisible to lsof), so a connection to either could
# silently hit the wrong database. 'Connection refused' on 55432 proved it clean.
DATABASE_URL=postgresql://cc:cc_dev_password@localhost:55432/career_copilot?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# ─── Auth secrets ─────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-48-bytes-of-base64-entropy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_TTL_REMEMBER_DAYS=30

# AES-256-GCM key for MFA secrets and OAuth tokens at rest.
# Must be exactly 32 bytes, base64-encoded:  openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-32-bytes-of-base64-entropy

COOKIE_DOMAIN=localhost
# Only ever true in local development. Production login requires a verified email.
ALLOW_UNVERIFIED_LOGIN=false

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
# 'mock' is the default so the whole product runs with no API key and CI never
# spends a token. Switch to 'anthropic' or 'openai' when you have credentials.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model routing — see docs/11-ai-prompt-design.md §3 for why these differ.
AI_MODEL_EXTRACTION=claude-haiku-4-5
AI_MODEL_STRUCTURING=claude-sonnet-5
AI_MODEL_WRITING=claude-opus-5

# Embeddings are a SEPARATE provider: Anthropic exposes no embeddings endpoint.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# ─── Object storage (S3-compatible) ───────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:59000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=cc_minio
STORAGE_SECRET_ACCESS_KEY=cc_minio_dev_password
STORAGE_BUCKET_UPLOADS=cc-uploads
STORAGE_BUCKET_EXPORTS=cc-exports
STORAGE_FORCE_PATH_STYLE=true

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Career Copilot <noreply@careercopilot.local>"

# ─── Quotas ───────────────────────────────────────────────────────────────────
QUOTA_FREE_AI_ACTIONS=10
QUOTA_FREE_RESUMES=2
QUOTA_PRO_AI_ACTIONS=500

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
METRICS_ENABLED=true
