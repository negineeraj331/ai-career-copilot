// Career Copilot — identity and audit domain (slice 0.3).
// Resume, JD, analysis, and application models land in Phase 1.
// Reference: docs/05-database-design.md

generator client {
  provider = "prisma-client-js"

  // Generated into our own source tree, not node_modules.
  //
  // Two problems this solves. First, `pnpm install` wipes a client generated
  // into the pnpm store, so the API stops booting until someone remembers to
  // regenerate — previously papered over with a postinstall hook. Second, and
  // fatally for deployment, `pnpm deploy` relinks a clean @prisma/client from
  // the store, so the production container started with a stub that has no
  // PrismaClient export at all. As a build artifact under src/, the client
  // travels with the code that imports it.
  output = "../src/generated/prisma"
}

// Prisma 7 removed `url` from the datasource block. The connection string now
// lives in prisma.config.ts (for the CLI) and reaches the client via a driver
// adapter. See docs/00-TRD.md ADR notes and prisma.config.ts in this app.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CANDIDATE
  MENTOR
  RECRUITER
  ADMIN
}

enum UserTier {
  FREE
  PRO
  TEAM
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum TokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MAGIC_LINK
  EMAIL_CHANGE
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum AuditEvent {
  REGISTER
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MAGIC_LINK_REQUESTED
  MAGIC_LINK_USED
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_FAILED
  RECOVERY_CODE_USED
  OAUTH_LINKED
  OAUTH_UNLINKED
  SESSION_REVOKED
  REFRESH_REUSE_DETECTED
  ACCOUNT_LOCKED
  ROLE_CHANGED
  DATA_EXPORTED
  ACCOUNT_DELETED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid(7)) @db.Uuid

  // Unique + nullable passwordHash is what makes account linking a data-model
  // property rather than an application workaround: a user who signs up with
  // Google and later sets a password is one row, not two.
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?

  name      String?
  avatarUrl String?

  role UserRole @default(CANDIDATE)
  tier UserTier @default(FREE)

  // Denormalised from MfaCredential so the login path can branch without a join.
  mfaEnabled Boolean @default(false)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  deviceSessions     DeviceSession[]
  verificationTokens VerificationToken[]
  mfaCredential      MfaCredential?
  resumes            Resume[]
  resumeVersions     ResumeVersion[]
  exportJobs         ExportJob[]

  @@index([role, deletedAt])
  @@index([deletedAt])
}

model OAuthAccount {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider OAuthProvider

  // The provider's stable account ID — never the email, which can change on the
  // provider side and would silently re-key the link.
  providerAccountId String

  // Only populated when we need to call the provider's API on the user's behalf.
  // AES-256-GCM at rest; never plaintext.
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model DeviceSession {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?

  // Truncated to /24 (IPv4) or /48 (IPv6). Enough to recognise a session,
  // less PII than a full address. docs/12 §8.
  ipPrefix    String?
  deviceLabel String?

  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String        @db.Uuid
  session   DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Every token descended from one login shares a familyId. Presenting a token
  // already marked ROTATED means two parties hold tokens from the same login,
  // so the whole family is revoked. This is the theft-detection mechanism.
  familyId String @db.Uuid

  // SHA-256 of the token. The raw value is NEVER stored — a database dump
  // yields hashes, not usable sessions.
  tokenHash String @unique

  parentId String? @db.Uuid

  status    TokenStatus @default(ACTIVE)
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([userId, status])
  @@index([familyId])
  @@index([sessionId])
  @@index([expiresAt])
}

// One table for every single-use token type. The lifecycle is identical across
// them (hash, TTL, consume once), so the consume-once logic is written and
// tested once instead of four times.
model VerificationToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      VerificationTokenType
  tokenHash String                @unique

  // Type-specific extras, e.g. the requested new address for EMAIL_CHANGE.
  payload Json?

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model MfaCredential {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AES-256-GCM, key from the environment. A plaintext secret column would hand
  // an attacker with read access the second factor along with the first.
  secretEnc String

  // argon2id hashes, single use. Shown to the user exactly once at enrolment.
  recoveryCodeHashes String[]

  confirmedAt DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Keyed on email+IP rather than the account alone, so an attacker cannot lock a
// known victim out of their own account by failing logins from elsewhere.
model LoginAttempt {
  id String @id @default(uuid(7)) @db.Uuid

  email    String
  ipPrefix String

  failedCount Int       @default(0)
  lockedUntil DateTime?
  lastAttempt DateTime  @default(now())

  @@unique([email, ipPrefix])
  @@index([lockedUntil])
}

// Append-only. The application database role holds no UPDATE or DELETE grant on
// this table — tamper resistance has to be enforced by the database, not by
// developer discipline. See the grant statement in the initial migration.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  // Deliberately NOT a foreign key.
  //
  // A relation here cannot coexist with the append-only trigger: `onDelete:
  // SetNull` issues an UPDATE against this table, the trigger refuses it, and
  // account deletion becomes impossible — which would break the 30-day purge
  // NFR-51 requires. `onDelete: Cascade` would be worse still, quietly erasing
  // the security trail of the account being removed.
  //
  // So this is a plain nullable column: a pseudonymous actor reference that
  // outlives the User row by design. It is a UUID, not PII, so retaining it
  // after a purge is exactly the documented behaviour. Nullable because a failed
  // login may have no known user at all.
  userId String? @db.Uuid

  event   AuditEvent
  outcome AuditOutcome @default(SUCCESS)

  ipPrefix     String?
  userAgent    String?
  resourceType String?
  resourceId   String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

// ─── Resume domain ────────────────────────────────────────────────────────────

enum ResumeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  // Set while an import is waiting for the user to confirm extracted data.
  // Reserved by slice 2.1; no code path produces it yet.
  AWAITING_CONFIRMATION
}

model Resume {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  templateId String  @default("minimal-ats")
  targetRole String?

  // The live snapshot. Nullable only for the instant between INSERT and the
  // first version row inside the creating transaction — a resume is never
  // observable without one.
  //
  // No `@relation` back-reference: ResumeVersion already points at Resume, and
  // a second relation in the opposite direction makes the pair mutually
  // required at insert time, which no ordering of two INSERTs can satisfy.
  currentVersionId String? @db.Uuid

  // Denormalised from the latest analysis so the list view renders without
  // joining analyses. Recomputed by the scoring path in slice 1.2; null until
  // a resume has been scored at all.
  atsScore Int?

  status ResumeStatus @default(DRAFT)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions   ResumeVersion[]
  exportJobs ExportJob[]

  // The exact shape of the list query: this user's undeleted resumes, newest
  // touched first. A composite in this order lets Postgres satisfy the filter
  // and the sort from one index without a sort step.
  @@index([userId, deletedAt, updatedAt(sort: Desc)])
}

// Immutable. There is no update path in the repository layer, and restoring an
// old version appends a new row rather than rewriting history — the same
// reasoning as AuditLog, for a different reason: here it is what makes version
// history trustworthy rather than what makes an audit trail admissible.
model ResumeVersion {
  id       String @id @default(uuid(7)) @db.Uuid
  resumeId String @db.Uuid
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  versionNumber Int

  // The full resume document, conforming to resumeDocumentSchema at
  // `schemaVersion`. Stored whole rather than as a delta: reading a version is
  // the common operation and must not require replaying a chain.
  content Json

  // SHA-256 over the canonical serialisation. Lets a save that changed nothing
  // coalesce onto the existing version instead of growing history by one row
  // per keystroke — autosave in slice 1.3 depends on this.
  contentHash String

  schemaVersion Int @default(1)

  changeSummary String?

  // Who wrote it. Nullable and SetNull rather than Cascade: deleting a
  // collaborator must not delete the versions they contributed to, which would
  // silently rewrite another user's history.
  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([resumeId, versionNumber])
  @@index([resumeId, createdAt(sort: Desc)])
  @@index([contentHash])
}

// ─── Exports ──────────────────────────────────────────────────────────────────

enum ExportFormat {
  PDF
  DOCX
  JSON
  MARKDOWN
  LATEX
}

enum ExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

// An export is a job, not a response. PDF rendering is CPU- and memory-bound and
// takes seconds, so holding an HTTP connection open for it would tie up a web
// process and time out behind any sensible proxy. The row is the durable record
// the client polls, and it outlives the worker that produced it.
model ExportJob {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String @db.Uuid
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  // Pinned at enqueue time. Without it, editing a resume while an export is
  // queued produces a file that matches neither what the user saw nor what they
  // asked for.
  versionId String @db.Uuid

  format     ExportFormat
  templateId String
  status     ExportStatus @default(QUEUED)

  // Key in the exports bucket. Null until the job succeeds.
  objectKey String?
  bytes     Int?

  // Safe to show a user. The underlying cause goes to the logs against the
  // job id, never into this column.
  error String?

  attempts Int @default(0)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([resumeId])
  @@index([status])
}

// ─── AI usage ─────────────────────────────────────────────────────────────────

// Every AI call writes a row, successful or not (docs/05 §3.5). This table is
// what makes the "AI cost per active user" budget measurable rather than
// aspirational — the numbers are real token counts from the provider's `usage`,
// not estimates from a spreadsheet.
model AiUsageLog {
  id String @id @default(uuid(7)) @db.Uuid

  // No foreign key, for the same reason as AuditLog: cost history must outlive
  // the account it belonged to, or deleting a user silently rewrites last
  // month's spend.
  userId String @db.Uuid

  feature         String
  promptTemplate  String
  // Part of the cache key too. A prompt edit changes what a row means, and a
  // row that does not say which version produced it cannot be compared.
  templateVersion Int

  provider String
  model    String

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)

  // Integer micros, never a float. Money in floating point accumulates error,
  // and a budget measured with a drifting number is not measured.
  costMicros Int @default(0)

  latencyMs Int     @default(0)
  cacheHit  Boolean @default(false)
  success   Boolean @default(true)
  errorCode String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
}
