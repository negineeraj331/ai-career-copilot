{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "noEmit": false
  },
  // src only. The root tsconfig.json also typechecks prisma.config.ts and the
  // seed, which must not be compiled into the runtime image.
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "tests"]
}
